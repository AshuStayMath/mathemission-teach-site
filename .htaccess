# Mathemission Teach (teach.mathemission.in) — Hostinger / Apache settings
Options -Indexes

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# App routes fall back to index.html (files and folders are served as they are)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddType image/svg+xml .svg
AddType "text/markdown; charset=utf-8" .md

<IfModule mod_headers.c>
  # Always check for a new app version
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # AK's Weekly Note: always fetch the latest
  <FilesMatch "\.(md|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed build files never change: cache for a year
  <FilesMatch "^(assets/.*|workbox-.*\.js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Android app link (Google Play app)
<Files "assetlinks.json">
  ForceType application/json
</Files>
